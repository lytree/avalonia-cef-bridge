{
  "identifier": "main",
  "description": "Main window desktop permissions",
  "windows": ["main"],
  "platforms": ["windows", "macos", "linux"],
  "permissions": [
    "core:app|get-info",
    "core:event|emit",
    "core:os|info",
    "core:path|resolve",
    "core:window|close",
    "core:window|minimize",
    "core:window|maximize",
    "core:window|unmaximize",
    "core:window|toggle-maximize",
    "core:window|hide",
    "core:window|show",
    "core:window|focus",
    "core:window|center",
    "core:window|set-title",
    "core:window|set-size",
    "core:window|set-position",
    "core:window|set-min-size",
    "core:window|set-max-size",
    "core:window|set-always-on-top",
    "core:window|set-resizable",
    "core:window|set-decorations",
    "core:window|set-fullscreen",
    "core:window|get-state",
    "core:window|list",
    "plugin:fs|read-text-file",
    "plugin:fs|write-text-file",
    "plugin:fs|read-dir",
    "plugin:fs|stat",
    "plugin:fs|exists",
    "plugin:fs|mkdir",
    "plugin:store|get",
    "plugin:store|set",
    "plugin:store|has",
    "plugin:store|keys",
    "plugin:store|delete"
  ]
}