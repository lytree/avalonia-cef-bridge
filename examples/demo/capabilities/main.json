{
  "identifier": "main",
  "description": "Main window desktop permissions (permission sets + scoped grants)",
  "windows": ["main"],
  "platforms": ["windows", "macos", "linux"],
  "events": [
    "window://moved",
    "window://resized",
    "window://focus-changed",
    "window://close-requested",
    "window://destroyed",
    "shell://theme-changed",
    "menu://item-clicked",
    "tray://clicked",
    "tray://menu-item-clicked",
    "notification://activated",
    "notification://dismissed",
    "global-shortcut://triggered",
    "app://second-instance",
    "window://file-drop-entered",
    "window://file-drop-left",
    "window://file-dropped",
    "webview://download-requested",
    "webview://navigation-requested",
    "webview://render-process-gone",
    "log://entry",
    "deeplink://tarui",
    "updater://status",
    "fs://watch-change",
    "scope://changed",
  ],
  "permissions": [
    "core:app|get-info",
    "core:event|emit",
    "core:os|info",
    "core:platform|capabilities",
    "core:path|resolve",
    "core:process|default",
    "core:shell|open",
    "core:clipboard|default",
    "core:cli|parse",
    "core:channel|stream-echo",

    "core:window|default",
    "core:window|other-window",
    {
      "identifier": "core:window|create",
      "allow": [{ "path": "editor" }]
    },

    "plugin:webview|default",
    "plugin:webview|navigate-other-webview",
    "plugin:webview|get-state-other-webview",
    "plugin:webview|set-zoom-other-webview",
    "plugin:webview|print-other-webview",
    "plugin:webview|set-bounds-other-webview",
    "plugin:webview|destroy-other-webview",
    "plugin:webview|create-other-window",

    "plugin:dialog|default",
    "plugin:menu|default",
    "plugin:window-state|default",
    "plugin:tray|default",
    "plugin:notification|default",
    "plugin:autostart|default",
    "plugin:updater|default",
    "plugin:deep-link|default",
    "plugin:persisted-scope|default",

    {
      "identifier": "plugin:global-shortcut|register",
      "allow": [
        { "path": "Ctrl+Shift+P" },
        { "path": "Ctrl+Shift+Y" },
        { "path": "Ctrl+Alt+*" }
      ],
      "deny": [
        { "path": "Ctrl+Alt+F4" }
      ]
    },
    {
      "identifier": "plugin:global-shortcut|unregister",
      "allow": [
        { "path": "Ctrl+Shift+P" },
        { "path": "Ctrl+Shift+Y" },
        { "path": "Ctrl+Alt+*" }
      ],
      "deny": [
        { "path": "Ctrl+Alt+F4" }
      ]
    },
    {
      "identifier": "plugin:global-shortcut|is-registered",
      "allow": [
        { "path": "Ctrl+Shift+P" },
        { "path": "Ctrl+Shift+Y" },
        { "path": "Ctrl+Alt+*" }
      ],
      "deny": [
        { "path": "Ctrl+Alt+F4" }
      ]
    },
    "plugin:global-shortcut|unregister-all",

    {
      "identifier": "plugin:store|get",
      "allow": [
        { "base": "appData", "path": "settings.json" },
        { "base": "appConfig", "path": "**/*.json" }
      ]
    },
    {
      "identifier": "plugin:store|set",
      "allow": [
        { "base": "appData", "path": "settings.json" },
        { "base": "appConfig", "path": "**/*.json" }
      ]
    },
    {
      "identifier": "plugin:store|has",
      "allow": [
        { "base": "appData", "path": "settings.json" },
        { "base": "appConfig", "path": "**/*.json" }
      ]
    },
    {
      "identifier": "plugin:store|delete",
      "allow": [
        { "base": "appData", "path": "settings.json" },
        { "base": "appConfig", "path": "**/*.json" }
      ]
    },
    {
      "identifier": "plugin:store|clear",
      "allow": [
        { "base": "appData", "path": "settings.json" },
        { "base": "appConfig", "path": "**/*.json" }
      ]
    },
    {
      "identifier": "plugin:store|keys",
      "allow": [
        { "base": "appData", "path": "settings.json" },
        { "base": "appConfig", "path": "**/*.json" }
      ]
    },

    "plugin:log|record",

    {
      "identifier": "plugin:fs|read-text-file",
      "allow": [
        { "base": "appData", "path": "documents/**" },
        { "base": "appConfig", "path": "**/*.json" },
        { "base": "appLog" },
        { "base": "temp" },
        { "base": "resources" }
      ]
    },
    {
      "identifier": "plugin:fs|write-text-file",
      "allow": [
        { "base": "appData", "path": "documents/**" },
        { "base": "appConfig", "path": "**/*.json" },
        { "base": "appLog" },
        { "base": "temp" }
      ]
    },
    {
      "identifier": "plugin:fs|read-dir",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" },
        { "base": "resources" }
      ]
    },
    "plugin:fs|stat",
    "plugin:fs|exists",
    {
      "identifier": "plugin:fs|mkdir",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" }
      ]
    },
    {
      "identifier": "plugin:fs|copy-file",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" }
      ]
    },
    {
      "identifier": "plugin:fs|rename",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" }
      ]
    },
    {
      "identifier": "plugin:fs|remove",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" }
      ],
      "deny": [
        { "base": "appConfig", "path": "settings/protected.json" }
      ]
    },
    {
      "identifier": "plugin:fs|read-file-stream",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" },
        { "base": "resources" }
      ]
    },
    {
      "identifier": "plugin:fs|write-begin",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" }
      ]
    },
    "plugin:fs|write-chunk",
    "plugin:fs|write-commit",
    "plugin:fs|write-cancel",
    {
      "identifier": "plugin:fs|watch",
      "allow": [
        { "base": "appData" },
        { "base": "appConfig" },
        { "base": "appCache" },
        { "base": "appLog" },
        { "base": "temp" },
        { "base": "resources" }
      ]
    },
    "plugin:fs|unwatch",

    {
      "identifier": "plugin:http|fetch",
      "allow": [
        { "path": "http://127.0.0.1:*/**" },
        { "path": "https://api.github.com/**" }
      ]
    },
    {
      "identifier": "plugin:http|upload",
      "allow": [
        { "path": "http://127.0.0.1:*/**" }
      ]
    },
    {
      "identifier": "plugin:shell|spawn",
      "allow": [
        { "path": "cmd.exe" },
        { "path": "ping.exe" },
        { "path": "powershell.exe" }
      ],
      "deny": []
    },
    "plugin:shell|stdin",
    "plugin:shell|kill",

    "plugin:sql|default",
    {
      "identifier": "plugin:sql|allow-load",
      "allow": [
        { "base": "appData", "path": "notes.db" }
      ]
    },

    "plugin:cookie|default",

    {
      "identifier": "plugin:websocket|connect",
      "allow": [
        { "path": "wss://echo.websocket.events/**" },
        { "path": "ws://127.0.0.1:*/**" }
      ]
    },
    "plugin:websocket|send",
    "plugin:websocket|close",

    "plugin:positioner|set-position"
  ]
}
