{
  "Tarui": {
    "Application": {
      "DeepLinkSchemes": ["tarui"]
    },
    "Notification": {
      "AumId": "dev.Demo",
      "DisplayName": "Tarui Demo"
    },
    "FileAssociations": [
      {
        "Ext": ".tdoc",
        "Name": "Tarui Demo Document",
        "Description": "Demo document owned by the Tarui demo app"
      }
    ],
    "Window": {
      "Title": "Tarui Demo",
      "Width": 1280,
      "Height": 820,
      "Center": true,
      "Decorations": true,
      "Resizable": true,
      // Force-close the window when the front-end never confirms a `window://close-requested`
      // event. Disable with `0` to require an explicit `core:window|close force=true`.
      "CloseRequestTimeout": 3.0
    },
    "Web": {
      "Policy": {
        "NavExternal": "https:*"
      }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information" } }
}
