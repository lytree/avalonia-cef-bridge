@* OS Info page: subscribes to a Tarui event and pulls `core:os|info` on demand. Demonstrates
   that `ListenAsync` from Blazor hands back an `IAsyncDisposable` whose lifetime the component
   controls.
*@

@inherits ComponentBase
@implements IAsyncDisposable
@inject ITaruiIpc Ipc

<section>
    <h2>OS Info</h2>
    <p>This page listens to <code>shell://theme-changed</code> while it is mounted and calls <code>core:os|info</code> on demand.</p>
    <button class="tarui-button" @onclick="RefreshAsync" disabled="@_loading">
        @(_loading ? "Loading..." : "Refresh OS info")
    </button>
    <p class="tarui-status">Last theme change: @(_theme ?? "(none yet)")</p>

    @if (_error is not null)
    {
        <p class="tarui-error">@_error</p>
    }
    else if (_info is not null)
    {
        <dl class="tarui-info">
            <dt>Platform</dt>
            <dd>@_info.Platform</dd>
            <dt>Arch</dt>
            <dd>@_info.Arch</dd>
            <dt>Family</dt>
            <dd>@_info.Family</dd>
            <dt>Version</dt>
            <dd>@_info.Version</dd>
            <dt>Locale</dt>
            <dd>@_info.Locale</dd>
        </dl>
    }
</section>

@code {
    private OsInfo? _info;
    private string? _error;
    private bool _loading;
    private string? _theme;
    private IAsyncDisposable? _subscription;

    protected override async Task OnInitializedAsync()
    {
        _subscription = await Ipc.ListenAsync<ThemeChanged>("shell://theme-changed", changed =>
        {
            _theme = $"{changed.Theme} @ {DateTime.Now:HH:mm:ss}";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Ipc.InvokeAsync<OsInfo>("core:os|info");
            _info = result.Success ? result.Value : null;
            _error = result.Success ? null : $"{(result.Error?.Code ?? "ERROR")}: {result.Error?.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscription is not null)
        {
            await _subscription.DisposeAsync();
        }
    }
}