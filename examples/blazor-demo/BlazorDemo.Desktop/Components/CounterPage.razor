@* Counter page: simple component that exercises Blazor rendering without IPC. Verifies the
   interactive circuit is alive end-to-end inside the Tarui WebView.
*@

@inherits ComponentBase

<section>
    <h2>Counter</h2>
    <p>This page does not call Tarui — it verifies the interactive Blazor render mode works inside the embedded WebView.</p>
    <p class="tarui-counter">
        <button class="tarui-button" @onclick="Increment">Increment</button>
        <button class="tarui-button" @onclick="Reset">Reset</button>
        <span class="tarui-badge">Count: @_count</span>
    </p>
</section>

@code {
    private int _count;

    private void Increment() => _count++;

    private void Reset() => _count = 0;
}