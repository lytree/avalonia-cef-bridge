@* App Info page: invokes `core:app|get-info` through `ITaruiIpc`. Verifies that a Blazor
   component can reach the Tarui command pipeline the same way the CEF WebView front-end does.
*@

@inherits ComponentBase
@inject ITaruiIpc Ipc

<section>
    <h2>App Info</h2>
    <p>This page calls <code>core:app|get-info</code> via <code>ITaruiIpc.InvokeAsync</code>.</p>
    <button class="tarui-button" @onclick="RefreshAsync" disabled="@_loading">
        @(_loading ? "Loading..." : "Refresh")
    </button>

    @if (_error is not null)
    {
        <p class="tarui-error">@_error</p>
    }
    else if (_info is not null)
    {
        <dl class="tarui-info">
            <dt>Product</dt>
            <dd>@_info.Product</dd>
            <dt>Shell version</dt>
            <dd>@_info.ShellVersion</dd>
            <dt>Bridge version</dt>
            <dd>@_info.BridgeVersion</dd>
            <dt>Platform</dt>
            <dd>@_info.Platform</dd>
            <dt>Capabilities</dt>
            <dd>@string.Join(", ", _info.Capabilities)</dd>
        </dl>
    }
</section>

@code {
    private AppHandshake? _info;
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Ipc.InvokeAsync<AppHandshake>("core:app|get-info");
            _info = result.Success ? result.Value : null;
            _error = result.Success ? null : $"{(result.Error?.Code ?? "ERROR")}: {result.Error?.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}