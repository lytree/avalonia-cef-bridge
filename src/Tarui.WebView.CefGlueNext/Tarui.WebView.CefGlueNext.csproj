<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tarui.WebView.CefGlueNext</RootNamespace>
    <AssemblyName>Tarui.WebView.CefGlueNext</AssemblyName>
    <CefGlueNextSourceRoot>$(MSBuildThisFileDirectory)..\..\third_party\CefGlue</CefGlueNextSourceRoot>
    <EnableCefGlueNextSourcePort>false</EnableCefGlueNextSourcePort>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tarui.WebView.Abstractions\Tarui.WebView.Abstractions.csproj" />
  </ItemGroup>
  <Target Name="RequireReviewedCefGlueSourceManifest" BeforeTargets="CoreCompile" Condition="'$(EnableCefGlueNextSourcePort)' == 'true'">
    <Error Code="TARUIWEBVIEW001" Text="CefGlue.Next source port is gated. Set CefGlueNextReviewedSourceFiles to an explicit, reviewed semicolon-separated file list. Do not compile upstream ObjectBinding or serializer files because they use reflection; Tarui IPC must keep its own static generated binding chain." Condition="'$(CefGlueNextReviewedSourceFiles)' == ''" />
  </Target>
  <ItemGroup Condition="'$(EnableCefGlueNextSourcePort)' == 'true' and '$(CefGlueNextReviewedSourceFiles)' != ''">
    <Compile Include="$(CefGlueNextReviewedSourceFiles)" />
  </ItemGroup>
</Project>
