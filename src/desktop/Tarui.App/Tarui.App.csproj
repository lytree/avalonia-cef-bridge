<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>tarui.net</AssemblyName>
    <RootNamespace>Tarui.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tarui.Hosting\Tarui.Hosting.csproj" />
    <ProjectReference Include="..\Tarui.Shell\Tarui.Shell.csproj" />
    <ProjectReference Include="..\..\webview\Tarui.WebView.CefGlueNext\Tarui.WebView.CefGlueNext.csproj" />
    <ProjectReference Include="..\..\plugins\Tarui.Plugins.Core\Tarui.Plugins.Core.csproj" />
    <ProjectReference Include="..\..\plugins\Tarui.Plugins.Dialog\Tarui.Plugins.Dialog.csproj" />
    <ProjectReference Include="..\..\plugins\Tarui.Plugins.Event\Tarui.Plugins.Event.csproj" />
    <ProjectReference Include="..\..\plugins\Tarui.Plugins.System\Tarui.Plugins.System.csproj" />
    <ProjectReference Include="..\..\plugins\Tarui.Plugins.Window\Tarui.Plugins.Window.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <TaruiCefRid Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(PlatformTarget)' != 'arm64'">win-x64</TaruiCefRid>
    <TaruiCefRid Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(PlatformTarget)' == 'arm64'">win-arm64</TaruiCefRid>
    <TaruiCefRid Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(PlatformTarget)' != 'arm64'">linux-x64</TaruiCefRid>
    <TaruiCefRid Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(PlatformTarget)' == 'arm64'">linux-arm64</TaruiCefRid>
    <TaruiCefRid Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(PlatformTarget)' != 'arm64'">osx-x64</TaruiCefRid>
    <TaruiCefRid Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(PlatformTarget)' == 'arm64'">osx-arm64</TaruiCefRid>
    <TaruiCefRuntimeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\runtime\cef\$(TaruiCefRid)'))</TaruiCefRuntimeRoot>
    <TaruiWebDistRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\web\apps\Tarui.Web\dist'))</TaruiWebDistRoot>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(TaruiCefRuntimeRoot)')">
    <Content Include="$(TaruiCefRuntimeRoot)\**\*" Link="CEF\$(TaruiCefRid)\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(TaruiWebDistRoot)\index.html')">
    <Content Include="$(TaruiWebDistRoot)\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\capabilities\*.json" Link="capabilities\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>