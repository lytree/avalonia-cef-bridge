<Project>
  <!-- 统一编译纪律（既有约定，保持不变） -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    W0：打包基线（docs/dev-workflow-design.md §6）。
    - 版本单源：全部可打包项目统一 Version = TaruiVersion，与 @lytree/api 0.1.0 对齐。
    - GenerateDocumentationFile 生成 XML 文档；缺注释类 CS1591/CS1573 等被抑制，
      以免在 TreatWarningsAsErrors 纪律下引发 289+ 编译错误。全包强制注释留待后续。
    - 需要单独排除打包的项目在其 .csproj 内显式设 IsPackable=false
      （演示应用 examples/demo、测试、cefglue 第三方源码等）。
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <TaruiVersion>0.1.0</TaruiVersion>
    <Version>$(TaruiVersion)</Version>
    <Authors>tarui.net contributors</Authors>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1574;CS1711;CS1712;CS1734</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <!-- 打包基线：每个可打包包随包携带仓库根 README（消除 NU5128）。-->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Link="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>